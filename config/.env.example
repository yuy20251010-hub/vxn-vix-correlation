# ============================================================
# 环境变量配置示例 - 复制为 .env 并填入真实值
# ============================================================

# --- 数据源 ---
# Yahoo Finance 无需 API Key（免费，但国内可能不稳定）
# Alpha Vantage 备用数据源 (免费 API Key: https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# --- 飞书应用配置 ---
# 从飞书开放平台 (https://open.feishu.cn) 获取
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here
FEISHU_VERIFICATION_TOKEN=your_verification_token_here
FEISHU_ENCRYPT_KEY=your_encrypt_key_here

# 每日推送目标 (飞书用户 open_id 或 chat_id)
# 多个目标用逗号分隔
FEISHU_PUSH_TARGETS=ou_xxxxxxxxxxxx

# --- 服务器 ---
HOST=0.0.0.0
PORT=8000

# 飞书事件订阅回调地址 (部署后填写真实 URL)
BASE_URL=https://your-domain.com

# --- 定时推送 ---
# 每日推送时间 (北京时间, cron 表达式)
PUSH_CRON_HOUR=9
PUSH_CRON_MINUTE=0

# --- 缓存 ---
# 缓存 TTL (秒, 默认 600 = 10 分钟)
CACHE_TTL_SECONDS=600
