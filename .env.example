# ── 飞书应用配置 ──
# 从飞书开放平台「开发者后台 → 应用详情 → 凭证与基础信息」获取
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxx
# （可选）事件订阅加密密钥
FEISHU_ENCRYPT_KEY=

# ── 每日推送目标（飞书 chat_id，多个用逗号分隔） ──
# 获取方式：群聊中添加机器人后，查看群聊信息或通过 API 获取
FEISHU_PUSH_CHAT_IDS=oc_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 外网可访问的 URL（用于卡片中的"查看仪表板"按钮） ──
# Railway/Render 部署后填写分配的域名
BASE_URL=https://your-app.railway.app

# ── 每日推送时间（北京时间） ──
PUSH_HOUR=9
PUSH_MINUTE=0
PUSH_TIMEZONE=Asia/Shanghai

# ── 数据缓存时间（秒，默认 600 = 10 分钟） ──
DATA_CACHE_TTL=600

# ── 备用数据源（可选） ──
# Alpha Vantage API Key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ── Yahoo Finance 代理（国内访问不稳定时使用） ──
# YFINANCE_PROXY=http://127.0.0.1:7890

# ── 服务器配置 ──
HOST=0.0.0.0
PORT=8000
